{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "gastroteam-api",
    "Audience": "gastroteam-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "Cookie": {
      "Name": "gt_refresh",
      "SameSite": "None",
      "Secure": true
    }
  },
  "App": {
    "WebBaseUrl": "https://metur100.github.io/Gastro.Team.App",
    "RequireEmailVerification": true,
    "ExposeInvitationLinkToInviter": true,
    "AllowManualPlanChange": false,
    "TrialDays": 30,
    "TrialPlanCode": "business",
    "InvitationValidityDays": 7,
    "PlatformAdminEmails": []
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "Security": "Auto",
    "FromAddress": "no-reply@gastroteam.example",
    "FromName": "GastroTeam",
    "UseDevMailbox": false
  },
  "Cors": {
    "AllowedOrigins": [ "https://metur100.github.io" ]
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 30,
    "GlobalPermitPerMinute": 600
  },
  "Swagger": {
    "Enabled": false
  },
  "Outbox": {
    "Enabled": true
  }
}
