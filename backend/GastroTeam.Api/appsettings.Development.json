{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=GastroTeam;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "SigningKey": "development-only-signing-key-change-me-0123456789"
  },
  "Auth": {
    "Cookie": {
      "SameSite": "Lax",
      "Secure": false
    }
  },
  "App": {
    "WebBaseUrl": "http://localhost:5173",
    "AllowManualPlanChange": true
  },
  "Email": {
    "UseDevMailbox": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173" ]
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 100
  }
}
