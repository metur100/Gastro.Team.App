# Example environment for GastroTeam. Copy values into your shell, user secrets or hosting panel.
# NEVER commit real values. Production secrets live outside the repository (see docs/DEPLOYMENT.md).

# --- API (ASP.NET Core; nested keys use double underscores) ---
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Server=(localdb)\MSSQLLocalDB;Database=GastroTeam;Trusted_Connection=True;TrustServerCertificate=True
Jwt__SigningKey=<at-least-32-random-characters>
App__WebBaseUrl=http://localhost:5300
App__RequireEmailVerification=true
App__AllowManualPlanChange=false
App__PlatformAdminEmails__0=
Cors__AllowedOrigins__0=http://localhost:5300
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromAddress=no-reply@example.com
Email__UseDevMailbox=true

# --- Web (Vite) ---
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:5191

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=https://gastroteam.runasp.net
EAS_PROJECT_ID=

# --- Tests ---
GT_TEST_SQL=Server=(localdb)\MSSQLLocalDB;Trusted_Connection=True;TrustServerCertificate=True
E2E_BASE_URL=http://localhost:5300
DEMO_PASSWORD=<choose-a-local-demo-password>
MSSQL_SA_PASSWORD=<local-docker-sa-password>
